# calm forest · 환경변수 템플릿 (이 파일은 커밋해도 됨, 실제 값 없음)
# 복사해서 .env 로 만들고 값을 채우세요.  cp .env.example .env

SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PASSWORD=your-db-password
DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.your-project-ref.supabase.co:5432/postgres
# SUPABASE_ANON_KEY 는 프론트(js/config.js)에 직접 넣습니다.
# 📸 사진첩 서버(/api/photo*)의 JWT 검증에도 필요 — 아래에 같은 값을 넣으세요(공개키라 안전).
SUPABASE_ANON_KEY=your-anon-key

# ── 📸 사진첩 (OCI Object Storage, S3 호환 API) ─────────────────
# ⚠️ 서버 전용 — 브라우저(js/config.js)에 절대 넣지 마세요.
#    로컬: 이 값을 .env 에 넣으면 scripts/serve.py 가 /api/photo* 를 제공합니다.
#    운영: Cloudflare → Workers → 설정 → 환경변수에 같은 이름으로 등록
#          (functions/api/photo.js 가 읽습니다)
#    키 발급: OCI 콘솔 → 프로필(우상단) → 내 프로필 → 고객 비밀 키(Customer secret keys)
#    비워두면 사진첩 기능이 꺼집니다(게임은 정상, ☁️ 버튼만 "준비 중" 안내).
OCI_NAMESPACE=id8g5usnkx1c
OCI_REGION=your-region            # 예: ap-chuncheon-1 (콘솔 우상단 리전 표시 참고)
OCI_BUCKET=your-bucket-name       # 예: calm-forest-photos (프라이빗 버킷)
OCI_ACCESS_KEY=your-access-key    # 고객 비밀 키의 액세스 키
OCI_SECRET_KEY=your-secret-key    # 생성 직후 한 번만 표시되는 시크릿

# ── Gemini (☕ 카페 손님 동적 생성) ─────────────────────────────
# ⚠️ 서버 전용 — 브라우저(js/config.js)에 절대 넣지 마세요.
#    로컬: 이 값을 .env 에 넣으면 scripts/serve.py 가 /api/cafe-guests 를 제공합니다.
#    운영: Cloudflare Pages → Settings → Environment variables 에 같은 이름으로 등록
#          (functions/api/cafe-guests.js 가 읽습니다)
#    키 발급: https://aistudio.google.com/apikey   비워두면 게임 내장 손님이 나옵니다.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-lite-latest

# ── 🦝 밤손님 판정 시드 시크릿 (/api/night-visit) ────────────────
# HMAC(시크릿, uid:날짜) 결정적 난수의 재료 — 유저가 결과를 예측/리롤하지 못하게 합니다.
# 비워두면 기본값으로 동작은 하지만, 운영에서는 임의의 긴 문자열을 권장합니다.
#    로컬: .env / 운영: Cloudflare 환경변수 (functions/api/night-visit.js 가 읽습니다)
NIGHT_SEED_SECRET=any-long-random-string
