# calm forest · 환경변수 템플릿 (이 파일은 커밋해도 됨, 실제 값 없음)
# 복사해서 .env 로 만들고 값을 채우세요.  cp .env.example .env

SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PASSWORD=your-db-password
DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.your-project-ref.supabase.co:5432/postgres
# SUPABASE_ANON_KEY 는 프론트(js/config.js)에 직접 넣습니다.

# ── Gemini (☕ 카페 손님 동적 생성) ─────────────────────────────
# ⚠️ 서버 전용 — 브라우저(js/config.js)에 절대 넣지 마세요.
#    로컬: 이 값을 .env 에 넣으면 scripts/serve.py 가 /api/cafe-guests 를 제공합니다.
#    운영: Cloudflare Pages → Settings → Environment variables 에 같은 이름으로 등록
#          (functions/api/cafe-guests.js 가 읽습니다)
#    키 발급: https://aistudio.google.com/apikey   비워두면 게임 내장 손님이 나옵니다.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-lite-latest

# ── 🤖 Claude Agent 슬랙봇 (slackbot/ — VM 상주) ─────────────────
# Slack 앱(api.slack.com/apps)에서 발급. xoxb=Bot Token, xapp=Socket Mode 토큰.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
# Claude Agent SDK 인증 — platform.claude.com 에서 발급(사용량 과금, 구독과 별개)
ANTHROPIC_API_KEY=sk-ant-your-api-key
# 봇 호출을 허용할 Slack 사용자 ID(콤마 구분). 비우면 전체 허용 — 개인 워크스페이스가 아니면 꼭 설정
ALLOWED_SLACK_USER_IDS=

# ── 🦝 밤손님 판정 시드 시크릿 (/api/night-visit) ────────────────
# HMAC(시크릿, uid:날짜) 결정적 난수의 재료 — 유저가 결과를 예측/리롤하지 못하게 합니다.
# 비워두면 기본값으로 동작은 하지만, 운영에서는 임의의 긴 문자열을 권장합니다.
#    로컬: .env / 운영: Cloudflare 환경변수 (functions/api/night-visit.js 가 읽습니다)
NIGHT_SEED_SECRET=any-long-random-string
