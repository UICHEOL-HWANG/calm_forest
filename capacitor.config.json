{
  "appId": "com.cheorish.lab.calmforest",
  "appName": "고요한 숲",
  "webDir": "dist-cap",
  "server": {
    "hostname": "app.calmforest.cloud",
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#1b2a1f"
  },
  "ios": {
    "backgroundColor": "#1b2a1f",
    "contentInset": "never"
  },
  "plugins": {
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": true,
        "twitter": false
      },
      "logLevel": 1
    }
  }
}
