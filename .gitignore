# 시크릿 — 절대 커밋 금지
.env
.env.*
!.env.example

# 잡파일
.DS_Store
node_modules/
*.log
__pycache__/

# 배포 번들(빌드 산출물)
dist/
dist-toss/
*.ait

# wrangler 로컬 캐시
.wrangler/

# 🧪 실험실(ml/) 로컬 잡파일 — venv 504MB · wandb 실행 기록.
#   ml/ 을 통째로 막으면 안 된다: ml 소스(calm_ml·api·notebooks)는 experiment 브랜치에서
#   실제로 추적 중이고, ml/.gitignore 가 하위 규칙을 따로 갖고 있다.
#   여기서 막는 이유는 ml/ 이 없는 브랜치(dev·main·toss)로 옮겨 오면 추적 파일만 사라지고
#   이 잡파일들만 미추적으로 남아 git status 를 어지럽히기 때문이다.
ml/.venv/
ml/wandb/

# Airflow 서비스계정 키(구글 시트·BigQuery) — VM /opt/airflow/secrets 에만 둔다
infra/airflow/secrets/
