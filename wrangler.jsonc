{
  // ⚠️ name 은 기존 배포 주소와 같아야 합니다.
  //    calmforest.icuchoel.workers.dev 로 서비스 중이므로 "calmforest".
  //    wrangler 가 처음 만들어준 "calm-forest"(하이픈) 로 두면 새 워커가 따로 생기고,
  //    기존 주소는 옛 내용 그대로 남습니다.
  "name": "calmforest",
  "compatibility_date": "2026-08-12",

  // 🌐 커스텀 도메인 — 대시보드 클릭 대신 코드로 선언(배포마다 보장, 환경변수 때와 같은 원칙).
  //    zone(calmforest.cloud)이 이 Cloudflare 계정에 있어야 하며, 배포 시 DNS·인증서가 자동 생성됩니다.
  "routes": [
    { "pattern": "calmforest.cloud", "custom_domain": true },
    { "pattern": "www.calmforest.cloud", "custom_domain": true }
  ],
  "compatibility_flags": ["nodejs_compat"],

  // 로그·트레이스 — 손님 생성 실패(키 만료·무료 한도 초과)는 게임이 조용히
  // 폴백하므로 유저는 모릅니다. 대시보드에서 확인하려면 이게 켜져 있어야 합니다.
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },

  // 서버 코드 진입점 — /api/cafe-guests 를 처리(Gemini 호출)하고 나머지는 자산으로 넘김
  "main": "worker/index.js",

  // 📸 사진첩 서버(/api/photo*)의 비밀 아닌 설정 — 여기 선언해야 배포마다 보장됩니다.
  // ⚠️ wrangler deploy 는 대시보드에서 손으로 넣은 "일반(텍스트) 변수"를 지웁니다(Secret 은 보존).
  //    그래서 공개값은 코드로 선언하고, 비밀키 2개(OCI_ACCESS_KEY·OCI_SECRET_KEY)는
  //    `npx wrangler secret put <이름>` 으로 Secret 등록합니다(GEMINI_API_KEY 와 같은 방식).
  "vars": {
    "OCI_NAMESPACE": "id8g5usnkx1c",
    "OCI_REGION": "us-ashburn-1",
    "OCI_BUCKET": "calm-forest",
    "SUPABASE_URL": "https://zuyxgjfihxtfdpolljzw.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_4ii948uQwLP2_W9eIW7Qcg_hWuFON9t"
  },

  // Gemini 무료 티어는 국가 제한이 있어, 홍콩(HKG) 엣지에서 호출하면 거부되는 것으로 보인다.
  //   (같은 키로 한국에서 직접 호출하면 200, 워커에서는 실패)
  // Workers 는 도시·국가 지정이 불가하고 클라우드 리전 지정만 된다 → 지원 확실한 미국으로.
  // 정적 자산은 이 설정과 무관하게 접속자와 가까운 엣지에서 서빙되므로 게임 로딩은 그대로다.
  //   (하루 한 번 캐시되는 손님 생성 요청만 이 리전을 탄다)
  "placement": { "region": "gcp:us-east4" },

  // dist/ 를 배포 직전에 만든다. dist/ 는 빌드 산출물이라 git 에 없으므로
  // CI(Workers Builds)가 clone 직후 바로 deploy 하면 "directory does not exist" 로 실패한다.
  // 여기 적어두면 대시보드 빌드 명령 설정 없이 `wrangler deploy` 한 줄로 끝난다(로컬도 동일).
  "build": {
    "command": "node scripts/build-web.mjs"
  },

  // 정적 자산은 dist/ 만. 저장소 루트를 그대로 올리면 .git · sql · scripts 까지 공개됨.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  }
}
